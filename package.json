{
  "name": "mindspace-dsh-session-memory",
  "version": "0.6.4",
  "description": "Task-conditioned Chat and Work session memory for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "Spirtxiaoqi7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spirtxiaoqi7/mindspace-dsh-session-memory.git"
  },
  "homepage": "https://github.com/Spirtxiaoqi7/mindspace-dsh-session-memory#readme",
  "bugs": "https://github.com/Spirtxiaoqi7/mindspace-dsh-session-memory/issues",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "agent-memory",
    "session-memory",
    "personalization",
    "multi-person-memory",
    "chat-work-memory"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./memory": "./lib/memory.js",
    "./client": "./lib/client.js",
    "./remote": "./lib/remote.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/repair-legacy-session-events.mjs",
    "assets/repository-logo.png",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/sync-generated-v5.mjs && node scripts/rescope-generated.mjs && tsdown && node scripts/normalize-build.mjs",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run test && pnpm pack --pack-destination dist"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-commands": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.28",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
